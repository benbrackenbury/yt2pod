# Required: list channels in channels.json. YOUTUBE_CHANNEL is only a fallback
# if that file is missing.
CHANNELS_FILE=./channels.json
BASE_URL=http://localhost:8000

# Shared fetch / feed defaults
FEED_LANGUAGE=en-us
FEED_CATEGORY=TV & Film
ITUNES_EXPLICIT=false
MAX_EPISODES=10
MAX_HEIGHT=720
EXCLUDE_SHORTS=true
MIN_DURATION=61
REFRESH_HOURS=6
REFRESH_ON_START=true
COOKIES_FILE=

# Server
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data
